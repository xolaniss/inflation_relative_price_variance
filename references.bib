@article{rather2018,
  title = {Inflation and the {{Dispersion}} of {{Relative Prices}}: {{A Case}} for 4 \% {{Solution}}},
  shorttitle = {Inflation and the {{Dispersion}} of {{Relative Prices}}},
  author = {Rather, Sartaj Rasool and Durai, Raja Sethu and Ramachandran, Muthia},
  year = 2018,
  month = mar,
  journal = {Australian Economic Papers},
  volume = {57},
  number = {1},
  pages = {81--91},
  issn = {0004-900X, 1467-8454},
  doi = {10.1111/1467-8454.12103},
  urldate = {2025-10-21},
  abstract = {Unlike earlier literature that documented positive association between inflation and the dispersion of relative prices               over time               , the empirical evidence from this study suggests that the relative price dispersion increases in response to the deviation of inflation from certain threshold/target level in either direction rather than inflation per se. The striking feature of the empirical evidence from United States and Japan is that the inflation rate at which the dispersion of relative prices is minimised turn out to be 4\%; hence, supporting the proposal of 4\% inflation target for both the countries.},
  langid = {english}
}

